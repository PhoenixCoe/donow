# Copy to .env.local when sign in is connected. Both values are safe on a website.
# NEVER put a secret or service_role key here. The deploy step stops if it finds one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ideas from Coe: the address of the Coe worker (the same one the Coe site uses). Leave empty to switch Ideas off.
NEXT_PUBLIC_COE_SERVER=
